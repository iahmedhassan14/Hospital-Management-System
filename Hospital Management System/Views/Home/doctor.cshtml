@model IEnumerable<Doctor>
<!-- Doctors Section -->
<section id="doctors" class="doctors section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Doctors</h2>
        <p>Necessitatibus eius consequatur ex aliquid fuga eum quidem sint consectetur velit</p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">

            @foreach (var item in @Model)
            {
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="team-member d-flex align-items-start">
                        <div class="pic"><img src="~/assets/img/doctors/@item.Img" class="img-fluid" alt=""></div>
                        <div class="member-info">
                            <h4>@item.Name</h4>
                            <span>@item.Specialization</span>
                            <a class="btn btn-primary rounded-pill px-4 mt-3 d-none d-sm-block bs-btn-bg: #1977cc;" href="/home/Appointment" style="background-color: #1977cc; color: white; border: none;">
                                Book An Appointment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>

</section><!-- /Doctors Section -->