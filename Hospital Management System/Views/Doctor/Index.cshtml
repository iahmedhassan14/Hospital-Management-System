@model DoctorVM
<!-- Doctors Section -->
<section id="doctors" class="doctors section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>Doctors</h2>
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <form asp-controller="Doctor" method="get">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control"
                               placeholder="Search doctors by name or specialization..."
                               value="@Model.Search" />
                        <button class="btn btn-outline-primary" type="submit">Search</button>
                    </div>
                </form>
            </div>
        </div>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">

            @foreach (var doctor in @Model.Doctor)
            {
                <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="team-member d-flex align-items-start">
                        <div class="pic"><img src="~/assets/img/doctors/@doctor.Img" class="img-fluid" alt=""></div>
                        <div class="member-info">
                            <h4>@doctor.Name</h4>
                            <span>@doctor.Specialization</span>
                            <a class="btn btn-primary rounded-pill px-4 mt-3 d-none d-sm-block bs-btn-bg: #1977cc;" href="/Doctor/Book?DoctorId=@doctor.Id" style="background-color: #1977cc; color: white; border: none;">
                                Book An Appointment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="row my-3">
            <div class="col-12 d-flex justify-content-center align-content-center">
                <nav area-label="page navigation">
                    <ul class="pagination">
                        @for (int i = 1; i <= Model.TotalPageNum; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Doctor"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@Model.Search">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>

    </div>

</section><!-- /Doctors Section -->