@model BookVM
<section id="appointment" class="appointment section">

    <!-- Section Title -->
    <div class="container section-title aos-init aos-animate" data-aos="fade-up">
        <h2>Appointment</h2>
        <p>Necessitatibus eius consequatur ex aliquid fuga eum quidem sint consectetur velit</p>
    </div><!-- End Section Title -->

    <div class="container aos-init aos-animate" data-aos="fade-up" data-aos-delay="100">

        <form id="appointmentForm" method="post" role="form" class="php-email-form" action="/Doctor/Book">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.AntiForgeryToken()
            <div class="row">
                <!-- Name -->
                <div class="col-md-6 form-group">
                    <input type="text" name="Name" class="form-control" id="name" placeholder="Your Name" required="">
                </div>

                <!-- Phone -->
                <div class="col-md-6 form-group">
                    <input type="tel" class="form-control" name="Phone" id="phone" placeholder="Your Phone" required="">
                </div>

                <!-- Date -->
                <div class="col-md-6 form-group mt-3">
                    <input type="text" name="Date" class="form-control datepicker" id="date" placeholder="Appointment Date" required="">
                    <div id="dateError" class="text-danger small"></div>
                </div>

                <!-- Doctor -->
                <div class="col-md-6 form-group mt-3">
                    <select name="DoctorId" id="doctor" class="form-select" required>
                        @if (Model.DoctorId > 0)
                        {
                            <option value="@Model.DoctorId" selected>@Model.DoctorName</option>
                            @foreach (var doctor in Model.Doctors.Where(d => d.Id != Model.DoctorId))
                            {
                                <option value="@doctor.Id">@doctor.Name</option>
                            }
                        }
                        else
                        {
                            <option value="">-- Select Doctor --</option>
                            @foreach (var doctor in Model.Doctors)
                            {
                                <option value="@doctor.Id">@doctor.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Message -->
                <div class="col-12 form-group mt-3">
                    <textarea class="form-control" name="Message" rows="5" placeholder="Message (Optional)"></textarea>
                </div>

                <!-- Submit Button -->
                <div class="col-12 text-center mt-3">
                    <div class="loading" style="display: none;">Loading...</div>
                    <div class="sent-message" style="display: none;">Success!</div>
                    <button type="submit" class="btn btn-primary">Book Appointment</button>
                </div>
            </div> <!-- END of row -->
        </form>

    </div>

</section>

<!-- Flatpickr JS and CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
    flatpickr("#date", {
        enableTime: true,
        dateFormat: "Y-m-d H:i",
        minTime: "09:00",
        maxTime: "21:00",
        minuteIncrement: 30,
        disable: [
            function (date) {
                // Disable Friday (5) and Saturday (6)
                return (date.getDay() === 5 || date.getDay() === 6);
            }
        ],
        minDate: "today" // disable past days
    });
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["Success"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["Success"]'
                    });
            </text>
        }
        else if (TempData["Error"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: '@TempData["Error"]'
                    });
            </text>
        }
        });
    </script>
}

