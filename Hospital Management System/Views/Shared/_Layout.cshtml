<body class="index-page">
    
        <header id="header" class="header sticky-top">

            <div class="topbar d-flex align-items-center">
                <div class="container d-flex justify-content-center justify-content-md-between">
                    <div class="contact-info d-flex align-items-center">
                    <i class="bi bi-envelope d-flex align-items-center"><a href="mailto:info@example.com">info@example.com</a></i>
                        <i class="bi bi-phone d-flex align-items-center ms-4"><span>+20 10 20304050</span></i>
                    </div>
                    <div class="social-links d-none d-md-flex align-items-center">
                    <a href="https://x.com" class="twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="https://facebook.com" class="facebook"><i class="bi bi-facebook"></i></a>
                    <a href="https://instagram.com" class="instagram"><i class="bi bi-instagram"></i></a>
                    <a href="https://linkedin.com" class="linkedin"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>

            <div class="branding d-flex align-items-center">

                <div class="container position-relative d-flex align-items-center justify-content-between">
                    <a href="/home" class="logo d-flex align-items-center me-auto">
                        <h1 class="sitename">Hospital</h1>
                    </a>

                    <nav id="navmenu" class="navmenu">
                        <ul>
                            <li><a href="/home" class="active">Home<br></a></li>
                            <li><a href="/home/doctor">Doctors</a></li>
                            <li><a href="/home/appointment">Book an Appointment</a></li>
                        </ul>
                        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
                    </nav>

                    <a class="cta-btn d-none d-sm-block" href="/home/listofappointment">List of Appointments</a>

                </div>

            </div>

        
    </header>

    <main class="main">
            @RenderBody()
        </main>

    <footer id="footer" class="footer light-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a href="index.html" class="logo d-flex align-items-center">
                        <span class="sitename">Hospital</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>Egypt</p>
                        <p>Mansoura</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>+20 10 20304050</span></p>
                        <p><strong>Email:</strong> <span>info@example.com</span></p>
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href="https://x.com"><i class="bi bi-twitter-x"></i></a>
                        <a href="https://facebook.com"><i class="bi bi-facebook"></i></a>
                        <a href="https://instagram.com"><i class="bi bi-instagram"></i></a>
                        <a href="https://linkedin.com"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
